# ==============================================================================
# CodeEagle Info Solutions - Backend Environment Configuration (FastAPI)
# ==============================================================================

PROJECT_NAME="Code Eagle Info Solution API"
API_V1_STR="/api/v1"

# Database Connection (PostgreSQL with asyncpg / psycopg2)
DATABASE_URL=postgresql+psycopg2://postgres:root@localhost:5432/codeeagle_db

# Security & JWT Configuration
SECRET_KEY=codeeagle_super_secret_jwt_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Default Seed Super Admin Credentials
ADMIN_EMAIL=admin@codeeagle.com
ADMIN_PASSWORD=AdminPassword123!
