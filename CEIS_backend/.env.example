# ==============================================================================
# CodeEagle Info Solutions - Production Backend Environment (FastAPI)
# ==============================================================================

PROJECT_NAME="Code Eagle Info Solution API"
API_V1_STR="/api/v1"

# Database Connection (Render PostgreSQL Connection String)
# Accepts postgresql://, postgresql+asyncpg://, or postgresql+psycopg2://
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/codeeagle_db

# Security & JWT Configuration
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_cryptographically_secure_64_character_hex_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Seed Super Admin Credentials
ADMIN_EMAIL=admin@codeeagle.com
ADMIN_PASSWORD=replace_with_a_strong_production_password

# Allowed CORS Origins
ALLOWED_ORIGINS="https://codeeagleinfosolutions.com,https://www.codeeagleinfosolutions.com,https://ceis-d1.vercel.app"
